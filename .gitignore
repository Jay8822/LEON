__pycache__/
*.py[cod]

# Runtime output — new log noise stays out, but pre-existing tracked
# logs (including the November 2025 history) are explicitly kept.
# Negations must come last: an earlier match can still be re-excluded
# by a later pattern (e.g. "*.log" would re-ignore a file un-ignored
# by an earlier rule), so exclude everything first, un-ignore after.
logs/*
*.log
crew_sessions.json
!logs/event_bus_history.log
!logs/system.log
!logs/gracie_process.log
!logs/eden_process.log

venv/
.venv/
.vscode/

# Scratch file used for review exchanges with Jay — not project content.
Ccode update.txt