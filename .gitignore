__pycache__/
*.py[cod]

# Runtime output — new log noise stays out, but pre-existing tracked
# logs (including the November 2025 history) are explicitly kept.
# Negations must come last: an earlier match can still be re-excluded
# by a later pattern (e.g. "*.log" would re-ignore a file un-ignored
# by an earlier rule), so exclude everything first, un-ignore after.
logs/*
*.log
crew_sessions.json
!logs/event_bus_history.log
!logs/system.log
!logs/gracie_process.log
!logs/eden_process.log

venv/
.venv/
.vscode/

# Detached long-running job logs/exit-codes (see Ccode update.txt's
# "detached background jobs" instructions) — local machine state, not
# project content. The wrapper script itself (run_detached.bat) is
# kept — negation must come last, same reasoning as logs/* above.
bg_jobs/*
!bg_jobs/run_detached.bat

# Editor/tooling config, not LEON itself.
.claude/
.mcp.json
.vs/

# Downloaded real-data test datasets -- never committed, see each
# real_data_tests/*/download_*.py for source and licence.
real_data_tests/*/data/

# Checkpointed test-run results (resumable, regenerable) -- not
# committed while a run is still in progress; revisit once finished.
real_data_tests/*/results/

# Scratch file used for review exchanges with Jay — not project content.
Ccode update.txt

# Jay's private handover brief — not for the public repo.
HANDOVER.md